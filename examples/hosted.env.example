# Copy to ~/.config/wechat-drafts/hosted.env and chmod 600.
# This file does not switch the plugin to remote MCP.
# DRAFT_ACCESS_TOKEN is an application password you generate, not a Cloudflare API token.
DRAFT_SYNC_URL=https://clash-art-draft.example.workers.dev
DRAFT_ACCESS_TOKEN=replace-with-at-least-32-characters
# Opt in to sync WeChat AppID/AppSecret (default is off):
# DRAFT_SYNC_SECRETS=1
